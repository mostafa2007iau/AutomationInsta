[Unit]
Description=Instagram Automation Backend Service
After=network.target

[Service]
User={{USER}}
Group={{USER}}
WorkingDirectory={{INSTALL_PATH}}
ExecStart={{INSTALL_PATH}}/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port {{BACKEND_PORT}}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
