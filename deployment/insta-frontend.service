[Unit]
Description=Instagram Automation Frontend Service
After=network.target

[Service]
User={{USER}}
Group={{USER}}
WorkingDirectory={{INSTALL_PATH}}/frontend
ExecStart={{INSTALL_PATH}}/.venv/bin/python3 -m http.server {{FRONTEND_PORT}}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
